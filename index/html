const mx=Math.max(...Object.values(sc)),dom=Object.keys(sc).filter(x=>sc[x]==mx);
const rd=v[10]+v[11]+v[12]+v[13]+4,df=AP[6].o[v[14]][1];
const kl=ks<=3?['Perlu penguatan prasyarat','Mulailah bertahap: tonton video pengantar, pelajari Materi 1 dan 2 dengan teliti, dan ulangi konsep mol serta molaritas. Jangan ragu bertanya kepada guru.']:ks<=6?['Berkembang','Kamu sudah memiliki bekal dasar. Perkuat bagian yang masih keliru (lihat daftar di bawah), lalu lanjutkan materi sesuai urutan.']:['Siap lanjut','Bekalmu kuat. Pelajari materi dengan cepat, lalu tantang dirimu dengan latihan SOLO tingkat tinggi dan studi kasus asesmen sumatif.'];

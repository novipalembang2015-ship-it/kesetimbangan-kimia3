<div class="card"><b>1. Bekal materi: ${kl[0]}</b> (${ks}/8 benar)<br>${kl[1]}</div>
${bars}
<div class="card"><b>2. Kesiapan belajar: ${rl[0]}</b> (skor ${rd}/16)<br>${rl[1]}</div>
<div class="card"><b>3. Gaya belajar dominan: ${dom.map(x=>STY[x][0]).join(' + ')}</b><br>${dom.map(x=>STY[x][1]).join('<br>')}</div>
<div class="card"><b>4. Tantanganmu</b><br>${DIF[df]}</div>
${wr.length?'<h3>Konsep yang perlu ditinjau</h3><ul class="r">'+wr.join('')+'</ul>':'<p>👍 Semua pertanyaan bekal materi terjawab tepat. Hebat!</p>'}
<p><b>Semangat belajar, ${n}!</b> Setiap langkah kecil membawamu semakin paham. 🌟</p>
<button class="btn" onclick="go('materi')">Mulai Materi Pembelajaran ▶</button></div>`;
$('ar').scrollIntoView({behavior:'smooth'})};
/* GAME */
const LV=['Teknisi Pemula','Operator Suhu','Insinyur Tekanan','Analis Qc'];
const OPT=['➡ Ke kanan (produk bertambah)','⬅ Ke kiri (pereaksi bertambah)','⏸ Tidak bergeser'];
const HB='N₂ + 3H₂ ⇌ 2NH₃ (ΔH = −92 kJ)',ND='N₂O₄ (tak berwarna) ⇌ 2NO₂ (cokelat) ΔH = +57 kJ';
const GR=[
{lv:1,sc:['f','Reaktor'],c:HB,s:'Operator menambahkan lebih banyak N₂ ke dalam reaktor.',a:0,e:'Sistem mengurangi gangguan: N₂ yang bertambah dipakai, sehingga bergeser ke kanan (NH₃ bertambah).'},
{lv:1,sc:['f','NH₃ cair'],c:HB,s:'NH₃ didinginkan, dicairkan, dan dikeluarkan terus-menerus dari reaktor.',a:0,e:'Produk dikurangi, sehingga sistem membentuk produk lagi: bergeser ke kanan. Inilah alasan NH₃ dikeluarkan di industri.'},
{lv:1,sc:['o'],c:'CO₂(g) + H₂O(l) ⇌ H⁺(aq) + HCO₃⁻(aq)',s:'Kadar CO₂ di atmosfer naik dan lebih banyak CO₂ larut ke laut.',a:0,e:'Pereaksi (CO₂) bertambah, sehingga bergeser ke kanan. [H⁺] naik dan pH laut turun (pengasaman laut).'},
{lv:2,sc:['t','ice'],c:ND,s:'Tabung berisi gas setimbang dicelupkan ke dalam air es.',a:1,e:'Suhu turun, sistem bergeser ke arah eksoterm, yaitu ke kiri (N₂O₄). Warna cokelat memudar.'},
{lv:2,sc:['t','hot'],c:ND,s:'Tabung berisi gas setimbang dipanaskan.',a:0,e:'Suhu naik, sistem bergeser ke arah endoterm, yaitu ke kanan (NO₂). Warna cokelat makin pekat.'},
{lv:2,sc:['f','450 °C → 600 °C'],c:HB,s:'Suhu reaktor dinaikkan dari 450 °C menjadi 600 °C.',a:1,e:'Reaksi ke kanan eksoterm. Suhu naik menggeser ke kiri (endoterm), sehingga rendemen NH₃ turun.'},
{lv:3,sc:['p','Volume diperkecil'],c:ND,s:'Piston ditekan sehingga volume gas diperkecil (suhu tetap).',a:1,e:'Volume mengecil berarti tekanan naik, sehingga bergeser ke sisi mol gas lebih kecil: 1 mol (N₂O₄), yaitu ke kiri.'},
{lv:3,sc:['f','200 → 300 atm'],c:HB,s:'Tekanan dalam reaktor dinaikkan dari 200 atm menjadi 300 atm.',a:0,e:'Pereaksi 4 mol gas, produk 2 mol gas. Tekanan naik menggeser ke sisi mol lebih kecil, yaitu kanan.'},
{lv:3,sc:['p','Volume diperkecil'],c:'H₂(g) + I₂(g) ⇌ 2HI(g)',s:'Volume wadah diperkecil pada suhu tetap.',a:2,e:'Jumlah mol gas kiri (2) sama dengan kanan (2), sehingga perubahan volume dan tekanan tidak menggeser kesetimbangan.'},
{lv:3,sc:['f','Katalis Fe'],c:HB,s:'Ke dalam reaktor ditambahkan katalis besi (Fe).',a:2,e:'Katalis mempercepat laju maju dan balik sama besar. Ia tidak menggeser kesetimbangan, hanya mempercepat tercapainya setimbang.'},
{lv:4,sc:['b',['2A ⇌ B     Kc = 10','[A] = 0,1 M','[B] = 0,2 M','Qc = ?']],c:'Reaksi 2A(g) ⇌ B(g), Kc = 10',s:'Pada suatu saat [A] = 0,1 M dan [B] = 0,2 M. Hitung Qc dan bandingkan dengan Kc.',a:1,e:'Qc = 0,2/(0,1)² = 20, lebih besar dari Kc (10). Produk berlebih, sehingga bergeser ke kiri.'},
{lv:4,sc:['b',['A ⇌ B     Kc = 2','[A] = 1 M','[B] = 0,5 M','Qc = ?']],c:'Reaksi A(g) ⇌ B(g), Kc = 2',s:'Pada suatu saat [A] = 1 M dan [B] = 0,5 M. Hitung Qc dan bandingkan dengan Kc.',a:0,e:'Qc = 0,5/1 = 0,5, lebih kecil dari Kc (2). Produk masih kurang, sehingga bergeser ke kanan.'}];
function scn(s){const t=s[0],x=s[1];let b='';
if(t=='f')b=`<rect x='110' y='28' width='80' height='86' rx='14' fill='#e8f1ff'/><rect x='20' y='52' width='90' height='10' fill='#7fb0ff'/><rect x='190' y='80' width='100' height='10' fill='#ffd166'/><rect x='125' y='8' width='14' height='22' fill='#9fc0ff'/><circle cx='132' cy='8' r='7' fill='#fff' opacity='.7'/><text x='150' y='76' text-anchor='middle' font-size='12' font-weight='700' fill='#0A2A66'>${x}</text><text x='24' y='44' fill='#fff' font-size='11'>N₂ + H₂ masuk</text><text x='196' y='74' fill='#fff' font-size='11'>NH₃ keluar</text>`;
if(t=='o')b=`<path d='M0 70 Q40 50 80 70 T160 70 T240 70 T320 70 V130 H0Z' fill='#2f7be0'/><path d='M0 98 Q40 78 80 98 T160 98 T240 98 T320 98 V130 H0Z' fill='#1b5fd8'/><text x='40' y='122' font-size='26'>🐠</text><text x='140' y='116' font-size='22'>🪸</text><text x='240' y='46' font-size='34'>🏭</text><text x='180' y='30' font-size='20' fill='#fff'>CO₂ ☁️</text>`;
if(t=='t')b=`<rect x='135' y='14' width='50' height='102' rx='14' fill='#e8f1ff'/><rect x='141' y='${x=='hot'?40:62}' width='38' height='70' rx='10' fill='${x=='hot'?'#a0522d':'#e0c9b3'}'/><text x='210' y='80' font-size='42'>${x=='hot'?'🔥':'🧊'}</text><text x='24' y='70' fill='#fff' font-size='12'>Tabung gas</text><text x='24' y='86' fill='#fff' font-size='12'>${x=='hot'?'dipanaskan':'di air es'}</text>`;
if(t=='p')b=`<rect x='70' y='48' width='150' height='40' rx='8' fill='#e8f1ff'/><rect x='76' y='54' width='84' height='28' rx='5' fill='#ffd9a8'/><rect x='160' y='51' width='8' height='34' fill='#1b5fd8'/><rect x='168' y='64' width='60' height='6' fill='#9fc0ff'/><rect x='226' y='54' width='10' height='26' rx='3' fill='#1b5fd8'/><text x='244' y='60' font-size='28'>👈</text><text x='24' y='112' fill='#fff' font-size='12'>${x}</text>`;
if(t=='b')b=`<rect x='20' y='10' width='280' height='110' rx='10' fill='#e8f1ff'/>${x.map((l,i)=>`<text x='34' y='${38+i*26}' font-size='15' font-weight='700' fill='#0A2A66'>${l}</text>`).join('')}<text x='262' y='108' font-size='26'>✏️</text>`;
return `<svg viewBox='0 0 320 130' style='display:block;width:100%' role='img' aria-label='Ilustrasi situasi misi'><rect width='320' height='130' fill='#0A2A66'/>${b}</svg>`}
let gi,lives,score,streak,gt,gl;
function gStart(){gi=0;lives=3;score=0;streak=0;$('gs').textContent='↻ Mulai ulang';gShow()}
function gShow(){const r=GR[gi];clearInterval(gt);gl=100;
$('gm').innerHTML=`<div class='hud'><span>Level ${r.lv}: ${LV[r.lv-1]}</span><span>Misi ${gi+1}/${GR.length}</span><span>${'❤'.repeat(lives)}</span><span>⭐ ${score}</span><span>🔥 Beruntun ${streak}</span></div><div class='tm' style='margin:10px 0'><i id='tb'></i></div><div style='border-radius:14px;overflow:hidden'>${scn(r.sc)}</div><div class='card'><b>${r.c}</b><br>${r.s}</div><p style='margin:4px 0'><b>Ke mana kesetimbangan bergeser?</b></p>${OPT.map((o,j)=>`<button class='go' onclick='gA(${j})'>${o}</button>`).join('')}<div id='gf'></div>`;
if(!$('nt').checked)gt=setInterval(()=>{if(!$('game').classList.contains('on'))return;gl-=.5;$('tb').style.width=Math.max(gl,0)+'%';if(gl<=0){clearInterval(gt);gA(-1)}},100)}
function gA(j){clearInterval(gt);const r=GR[gi],ok=j==r.a;
document.querySelectorAll('#gm .go').forEach((b,k)=>{b.disabled=true;if(k==r.a)b.classList.add('ok');else if(k==j)b.classList.add('no')});
let h;if(ok){streak++;const p=10+(document.getElementById('nt').checked?3:Math.round(gl/20))+(streak>=3?3:0);score+=p;h=`<span style='font-size:30px'>👍</span> ${OK[Math.floor(Math.random()*3)]} <b>+${p} poin</b><br>${r.e}`}
else{streak=0;lives--;h=`${j<0?'Waktu habis! ':''}${NO[Math.floor(Math.random()*3)]}<br><b>Pembahasan:</b> ${r.e}`}
const last=gi==GR.length-1||lives==0;
$('gf').innerHTML=`<div class='fb pop ${ok?'ok':'no'}'>${h}</div><button class='btn' style='margin-top:10px' onclick='${last?'gEnd()':'gN()'}'>${last?'Lihat hasil':'Misi berikutnya ▶'}</button>`;
$('gf').scrollIntoView({behavior:'smooth',block:'nearest'})}
function gN(){gi++;gShow()}
function gEnd(){const win=lives>0,b=win?(score>=150?['🏆','Master Kesetimbangan']:['🥇','Insinyur Kimia']):['🌱','Teknisi Magang'];
$('gm').innerHTML=`<div class='card w pop' style='text-align:center'><div style='font-size:56px'>${b[0]}</div><h3>${win?'Misi selesai!':'Nyawa habis, tetapi kamu sudah berusaha!'}</h3><p>Gelar: <b>${b[1]}</b><br>Skor: <b>${score}</b> · Level tercapai: ${LV[GR[gi].lv-1]}</p><p>${win?'Kamu memahami cara sistem setimbang melawan gangguan. Lanjutkan ke Latihan Soal!':'Baca kembali Materi 3 dan 4, coba lagi, dan kamu pasti bisa naik level. 💪'}</p><button class='btn' onclick='gStart()'>↻ Main lagi</button> <button class='btn o' onclick="go('latihan')">Ke Latihan Soal ▶</button></div>`}
$('gs').onclick=gStart;
</script></body></html>

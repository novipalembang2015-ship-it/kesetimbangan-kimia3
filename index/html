const col=['#b3261e','#9a5b00','#0a7a3d'],lb=['Perlu penguatan','Berkembang','Kuat'];
const bars=ASP.map((a,i)=>{const s=asp[i];return `<div style="margin:8px 0"><div style="font-size:14px">${a}</div><div class="bar" style="width:${Math.max(30,s*50)}%;background:${col[s]}">${lb[s]} (${s}/2)</div></div>`}).join('');
window.AW={n,k,ks,rd,dom};$('nm').value=n;$('kl').value=k;
